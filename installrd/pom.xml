<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.installr</groupId>
        <artifactId>installr-project</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>installrd</artifactId>

    <description>Installrd - A multi-purpose package installr</description>
    <url>https://installr.io</url>

    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <?SORTPOM IGNORE?>
        <!-- packaging -->
        <non-packaged-resources.source.directory>
            ${project.basedir}/src/main/non-packaged-resources
        </non-packaged-resources.source.directory>
        <non-packaged-resources.target.directory>
            ${project.build.directory}/non-packaged-resources
        </non-packaged-resources.target.directory>
        <installrd-bin.directory>/opt/installr-io/bin</installrd-bin.directory>
        <installrd-doc.directory>/opt/installr-io/share/doc/installrd</installrd-doc.directory>
        <installrd-user>installr</installrd-user>
	<?SORTPOM RESUME?>

        <!-- skip install & deploy -->
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- quarkus dependencies -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-config-yaml</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-client-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-credentials</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-h2</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-liquibase</artifactId>
            <exclusions>
                <exclusion>
                    <!-- excluded: license incompatible; only needed for loadData/loadUpdateData changesets -->
                    <groupId>com.opencsv</groupId>
                    <artifactId>opencsv</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-kubernetes-client</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-fault-tolerance</artifactId>
        </dependency>

        <!-- our own dependencies -->
        <dependency>
            <groupId>io.installr</groupId>
            <artifactId>installr-lib-installrd</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.installr</groupId>
            <artifactId>installr-lib-deployer</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.installr</groupId>
            <artifactId>installr-lib-registry</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 3rd party dependencies -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-properties</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
	    <!-- used by the build-in Liquibase Deployer -->
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>de.gesellix</groupId>
            <artifactId>docker-client</artifactId>
        </dependency>
        <dependency>
            <?SORTPOM IGNORE?>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy</artifactId> <!-- needed by docker-client -->
            <?SORTPOM RESUME?>
        </dependency>

        <!-- test dependencies -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit-mockito</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.fabric8</groupId>
            <artifactId>kubernetes-server-mock</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.smallrye</groupId>
            <artifactId>smallrye-fault-tolerance-standalone</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <resources>
            <resource>
                <filtering>false</filtering>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>**/*.properties</exclude>
                </excludes>
            </resource>
            <resource>
                <filtering>true</filtering>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-dependency-licenses</id>
                        <goals>
                            <goal>add-third-party</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>buildnumber-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-buildnumber</id>
                        <goals>
                            <goal>create</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-non-packaged-resources</id>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <resources>
                                <resource>
                                    <directory>${non-packaged-resources.source.directory}</directory>
                                    <filtering>true</filtering>
                                    <excludes>
                                        <exclude>config/**</exclude>
                                    </excludes>
                                </resource>
                                <resource>
                                    <directory>${non-packaged-resources.source.directory}</directory>
                                    <filtering>false</filtering>
                                    <includes>
                                        <include>config/**</include>
                                    </includes>
                                </resource>
                            </resources>
                            <outputDirectory>${non-packaged-resources.target.directory}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                        <configuration>
                            <systemProperties>
                                <quarkus.application.version>${project.version}</quarkus.application.version>
                            </systemProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- https://github.com/quarkusio/quarkus/issues/44446 -->
                    <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-linux-executable</id>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <phase>package</phase>
                        <configuration>
                            <?SORTPOM IGNORE?>
                            <target>
                                <concat binary="yes" destfile="${project.build.directory}/${project.build.finalName}"
                                    eol="unix">
                                    <filelist dir="${project.build.directory}"
                                        files="${non-packaged-resources.target.directory}/stub.sh" />
                                    <filelist dir="${project.build.directory}" files="${project.build.finalName}.jar" />
                                </concat>
                                <exec executable="scripts/adjust_zip_offsets.py" failonerror="true">
                                    <arg value="${project.build.directory}/${project.build.finalName}"/>
                                    <arg value="1583"/> <!-- size of stub.sh -->
                                </exec>
                                <chmod file="${project.build.directory}/${project.build.finalName}" perm="0750" />
                            </target>
			    <?SORTPOM RESUME?>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
